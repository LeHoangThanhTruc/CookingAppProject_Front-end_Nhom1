<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg"
    android:fillViewport="true"
    tools:ignore="HardcodedText,Autofill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Nút Quay lại (Back Button) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                android:elevation="2dp"
                app:tint="@color/panda_green_dark" />

            <!-- Khối Tiêu đề màn hình -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">


                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món ăn đã lưu"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách các món ăn đã lưu"
                    android:textColor="@color/panda_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nút Bookmark (Top Right Icon) -->
            <ImageButton
                android:id="@+id/btnBookmarkHeader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="Đã lưu"
                android:elevation="2dp"
                app:tint="@color/panda_green" />

        </LinearLayout>

        <!-- SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:elevation="1dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivSearchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Tìm kiếm"
                app:tint="@color/panda_green" />

            <EditText
                android:id="@+id/etSearchSaved"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Tìm trong danh sách đã lưu..."
                android:textColor="@color/panda_green_dark"
                android:textColorHint="@color/panda_gray"
                android:textSize="14sp"
                android:layout_marginStart="10dp"
                android:inputType="text" />
        </LinearLayout>

        <!-- FILTER CHIPS ROW -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1: Tất cả (Selected) -->
                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip 2: Món chính -->
                <TextView
                    android:id="@+id/chipMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món chính"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip 3: Nhanh gọn -->
                <TextView
                    android:id="@+id/chipQuick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhanh gọn"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip 4: Tráng miệng -->
                <TextView
                    android:id="@+id/chipDessert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tráng miệng"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- RECIPE ITEM 1: GỎI CUỐN TÔM THỊT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivRecipe1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_cream"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gear"
                android:contentDescription="Món ăn" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvRecipe1Category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món cuốn"
                    android:textColor="@color/panda_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecipe1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gỏi Cuốn Tôm Thịt"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvRecipe1Details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 phút • Dễ • 4 người"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Rating row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star"
                        app:tint="#F59E0B"
                        android:contentDescription="Star" />

                    <TextView
                        android:id="@+id/tvRecipe1Rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBookmark1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_published"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="Đã lưu"
                app:tint="@color/panda_green" />
        </LinearLayout>

        <!-- RECIPE ITEM 2: CƠM GÀ XỐI MỠ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivRecipe2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_cream"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gear"
                android:contentDescription="Món ăn" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvRecipe2Category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món chính"
                    android:textColor="@color/panda_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecipe2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cơm Gà Xối Mỡ"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvRecipe2Details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35 phút • Trung bình"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Rating row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star"
                        app:tint="#F59E0B"
                        android:contentDescription="Star" />

                    <TextView
                        android:id="@+id/tvRecipe2Rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.7"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBookmark2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_published"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="Đã lưu"
                app:tint="@color/panda_green" />
        </LinearLayout>

        <!-- RECIPE ITEM 3: CHÈ KHÚC BẠCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivRecipe3"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_cream"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gear"
                android:contentDescription="Món ăn" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvRecipe3Category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tráng miệng"
                    android:textColor="@color/panda_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecipe3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chè Khúc Bạch"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvRecipe3Details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 phút • Dễ"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Rating row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star"
                        app:tint="#F59E0B"
                        android:contentDescription="Star" />

                    <TextView
                        android:id="@+id/tvRecipe3Rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.9"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBookmark3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_published"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="Đã lưu"
                app:tint="@color/panda_green" />
        </LinearLayout>

        <!-- RECIPE ITEM 4: MÌ Ý SỐT BÒ BẰM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivRecipe4"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_cream"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gear"
                android:contentDescription="Món ăn" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvRecipe4Category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món nhanh"
                    android:textColor="@color/panda_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecipe4Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mì Ý Sốt Bò Bằm"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvRecipe4Details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 phút • Dễ"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Rating row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star"
                        app:tint="#F59E0B"
                        android:contentDescription="Star" />

                    <TextView
                        android:id="@+id/tvRecipe4Rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.6"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBookmark4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_published"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="Đã lưu"
                app:tint="@color/panda_green" />
        </LinearLayout>

        <!-- BOTTOM BUTTON: LÊN LỊCH NẤU ĂN -->
        <LinearLayout
            android:id="@+id/btnScheduleCooking"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivPlusIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_plus"
                android:contentDescription="Thêm"
                app:tint="@color/panda_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvScheduleCooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lên lịch nấu ăn"
                android:textColor="@color/panda_green"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>