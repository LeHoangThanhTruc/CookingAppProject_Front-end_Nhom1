<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg"
    android:fillViewport="true"
    tools:ignore="HardcodedText,Autofill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Nút Quay lại (Back Button) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                android:elevation="2dp"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Nút Thông báo -->
            <ImageButton
                android:id="@+id/btnNotificationHeader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_bell"
                android:contentDescription="Thông báo"
                android:elevation="2dp"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark"
                android:layout_marginEnd="10dp" />

            <!-- Nút Avatar User -->
            <ImageButton
                android:id="@+id/btnAvatarHeader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_panda_avatar"
                android:contentDescription="Tài khoản"
                android:elevation="2dp"
                android:scaleType="centerCrop"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />

        </LinearLayout>

        <!-- SCREEN TITLE -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lịch nấu ăn"
            android:textColor="@color/panda_green_dark"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- WEEK SELECTION CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipLastWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuần trước"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipThisWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuần này"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipNextWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuần sau"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- DATE NUMBERS STRIP -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="12/11" android:textColor="@color/panda_green_dark" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="13/11" android:textColor="@color/panda_gray" android:textSize="13sp" android:gravity="center" />
                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="14/11" android:textColor="@color/panda_gray" android:textSize="13sp" android:gravity="center" />
                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="15/11" android:textColor="@color/panda_gray" android:textSize="13sp" android:gravity="center" />
                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="16/11" android:textColor="@color/panda_gray" android:textSize="13sp" android:gravity="center" />
                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="17/11" android:textColor="@color/panda_gray" android:textSize="13sp" android:gravity="center" />
                <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="18/11" android:textColor="@color/panda_gray" android:textSize="13sp" android:gravity="center" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ==================== THỨ 2 (EXPANDED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <!-- Day Header Row -->
            <LinearLayout
                android:id="@+id/headerDay1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thứ 2"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12/11"
                        android:textColor="@color/panda_gray"
                        android:textSize="12sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivDay1Toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_up"
                    android:contentDescription="Thu gọn"
                    android:tint="@color/panda_green_dark"
                    app:tint="@color/panda_green_dark" />
            </LinearLayout>

            <!-- Slot 1: Sáng (Đã lên lịch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_badge_published"
                android:padding="14dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sáng • 07:00–08:00"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã lên lịch"
                        android:textColor="@color/panda_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_circle_white"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <!-- Recipe row inside slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="10dp"
                    android:elevation="1dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_cream"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_gear"
                        android:contentDescription="Phở Bò" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phở Bò"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khung giờ gợi ý • Có thể chỉnh"
                            android:textColor="@color/panda_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Slot 2: Trưa (Chưa lên lịch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_published"
                android:padding="14dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trưa • 12:00–13:00"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa lên lịch"
                    android:textColor="@color/panda_gray"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_white"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnChooseRecipe2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Chọn món đã lưu"
                android:textColor="@color/panda_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Slot 3: Chiều (Chưa lên lịch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_published"
                android:padding="14dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chiều • 17:00–18:00"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa lên lịch"
                    android:textColor="@color/panda_gray"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_white"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnChooseRecipe3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Chọn món đã lưu"
                android:textColor="@color/panda_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- ==================== THỨ 3 (COLLAPSED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thứ 3"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13/11"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Mở rộng"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />
        </LinearLayout>

        <!-- ==================== THỨ 4 (COLLAPSED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thứ 4"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14/11"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Mở rộng"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />
        </LinearLayout>

        <!-- ==================== THỨ 5 (COLLAPSED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thứ 5"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/11"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Mở rộng"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />
        </LinearLayout>

        <!-- ==================== THỨ 6 (COLLAPSED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thứ 6"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16/11"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Mở rộng"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />
        </LinearLayout>

        <!-- ==================== THỨ 7 (COLLAPSED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thứ 7"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17/11"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Mở rộng"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />
        </LinearLayout>

        <!-- ==================== CHỦ NHẬT (COLLAPSED) ==================== -->
        <LinearLayout
            android:id="@+id/cardDay7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chủ nhật"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18/11"
                    android:textColor="@color/panda_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Mở rộng"
                android:tint="@color/panda_green_dark"
                app:tint="@color/panda_green_dark" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>