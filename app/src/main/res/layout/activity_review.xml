<?xml version="1.0" encoding="utf-8"?>
<!-- Root Container: LinearLayout tràn background1.png -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background1"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/main_screen_padding_horizontal"
            android:paddingEnd="@dimen/main_screen_padding_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ================= TOP HEADER ================= -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_top_tag"
                        android:textColor="#2D7A32"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/review_top_title"
                        android:textColor="#193B1C"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_light_green"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/bxs_user" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/review_top_sub"
                android:textColor="#4A704D"
                android:textSize="13sp" />


            <!-- ================= 1. CARD ĐÁNH GIÁ CỦA BẠN (CHỌN SAO) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_white"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:src="@drawable/face_panda" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_your_rating_title"
                            android:textColor="#193B1C"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/review_your_rating_sub"
                            android:textColor="#718096"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dãy 5 sao chọn -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star1"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_pill_white"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/star" />

                    <ImageView
                        android:id="@+id/star2"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/star" />

                    <ImageView
                        android:id="@+id/star3"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/star" />

                    <ImageView
                        android:id="@+id/star4"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/star" />

                    <ImageView
                        android:id="@+id/star5"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_green"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/star" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#F0F7F0"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="@string/review_rating_5star_tag"
                        android:textColor="#2D7A32"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/review_rating_5star_sub"
                        android:textColor="#718096"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <!-- ================= 2. CARD BÌNH LUẬN & ĐÍNH KÈM ẢNH/VIDEO ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_white"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:src="@drawable/face_panda" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_comment_title"
                            android:textColor="#193B1C"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/review_comment_sub"
                            android:textColor="#718096"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hai nút thêm (+ Ảnh / + Video) bằng XML Nét đứt, Icon nằm sát bên trái chữ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Nút + Ảnh -->
                    <LinearLayout
                        android:id="@+id/btnAddPicture"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashed_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/picture_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/review_btn_add_picture"
                            android:textColor="#2D7A32"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Nút + Video -->
                    <LinearLayout
                        android:id="@+id/btnAddVideo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashed_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/video_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/review_btn_add_video"
                            android:textColor="#2D7A32"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- KHU VỰC HIỂN THỊ PHƯƠNG TIỆN ĐÃ TẢI LÊN (CÓ NÚT THÙNG RÁC XÓA TRASH.XML) -->
                <LinearLayout
                    android:id="@+id/layoutMediaPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- Preview Ảnh đính kèm + Thùng rác -->
                    <RelativeLayout
                        android:id="@+id/itemImagePreview"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/disk_goicuon_vuong" />

                        <ImageView
                            android:id="@+id/btnDeleteImage"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="#99000000"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/trash" />
                    </RelativeLayout>

                    <!-- Preview Video đính kèm + Thùng rác -->
                    <RelativeLayout
                        android:id="@+id/itemVideoPreview"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="10dp"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/videohuongdan_img_template" />

                        <ImageView
                            android:id="@+id/btnDeleteVideo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="#99000000"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/trash" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Ô nhập bình luận trải nghiệm -->
                <EditText
                    android:id="@+id/edtReviewComment"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:autofillHints="none"
                    android:background="#F0F7F0"
                    android:gravity="top|start"
                    android:hint="@string/review_comment_hint"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="#193B1C"
                    android:textColorHint="#9EAFA0"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tvCharCount"
                        android:text="@string/review_comment_footer_hint"
                        android:textColor="#A0AEC0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvCharCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/review_comment_char_count"
                        android:textColor="#A0AEC0"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>


            <!-- Khung Lưu ý -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F0F7F0"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/circle_info_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/review_warning_text"
                    android:textColor="#4A704D"
                    android:textSize="12sp" />
            </LinearLayout>


            <!-- NÚT HỦY VÀ NÚT GỬI (CẢ 2 CÙNG QUAY VỀ RECIPEDETAILACTIVITY) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelReview"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E53E3E"
                    android:text="@string/review_btn_cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubmitReview"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#27672B"
                    android:text="@string/review_btn_submit"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>