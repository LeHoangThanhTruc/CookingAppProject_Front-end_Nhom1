<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background1"
    android:orientation="vertical"
    android:paddingStart="@dimen/forgot_screen_padding_horizontal"
    android:paddingEnd="@dimen/forgot_screen_padding_horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    tools:ignore="UnusedResources">

    <!-- ================= 1. TOP HEADER BAR ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nút Back quay về -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_pill_white"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/vector_back" />

        <!-- Chữ Quên mật khẩu nằm ở vị trí giữa, bên dưới nút Back -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnBack"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="@string/reset_header_title"
            android:textColor="#193B1C"
            android:textSize="@dimen/forgot_title_size"
            android:textStyle="bold" />
    </RelativeLayout>


    <!-- ================= 2. CARD HƯỚNG DẪN (BANNER TRẮNG) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Icon Shield lồng trong deco_circle_ -->
        <RelativeLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/deco_circle_" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"
                android:contentDescription="@null"
                android:src="@drawable/shield" />
        </RelativeLayout>

        <!-- Tiêu đề Banner -->
        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reset_banner_title"
            android:textColor="#193B1C"
            android:textSize="@dimen/forgot_banner_title_size"
            android:textStyle="bold" />

        <!-- Mô tả Banner -->
        <TextView
            android:id="@+id/tvBannerDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/reset_banner_desc"
            android:textColor="#718096"
            android:textSize="@dimen/forgot_banner_desc_size" />
    </LinearLayout>


    <!-- ================= 3. CARD FORM NHẬP LẠI MẬT KHẨU ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_white"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Mật khẩu mới -->
        <TextView
            android:id="@+id/tvLabelNewPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_label_new_password"
            android:textColor="#193B1C"
            android:textSize="@dimen/forgot_label_size"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layoutInputNewPass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forgot_input_height"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/iconEyeOpen1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:src="@drawable/eye_open" />

            <EditText
                android:id="@+id/edtNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/iconEyeOpen1"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/reset_hint_new_password"
                android:inputType="textPassword"
                android:textColor="#2D3748"
                android:textColorHint="#A0AEC0"
                android:textSize="@dimen/forgot_input_text_size" />
        </RelativeLayout>

        <!-- Khung chú thích quy định mật khẩu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F0F7F0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/circle_info_icon" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/reset_note_password_policy"
                android:textColor="#4A704D"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2. Nhập lại mật khẩu -->
        <TextView
            android:id="@+id/tvLabelConfirmPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reset_label_confirm_password"
            android:textColor="#193B1C"
            android:textSize="@dimen/forgot_label_size"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layoutInputConfirmPass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forgot_input_height"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/iconEyeOpen2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:src="@drawable/eye_open" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/iconEyeOpen2"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/reset_hint_confirm_password"
                android:inputType="textPassword"
                android:textColor="#2D3748"
                android:textColorHint="#A0AEC0"
                android:textSize="@dimen/forgot_input_text_size" />
        </RelativeLayout>

        <!-- Nút Xác nhận đặt lại -->
        <RelativeLayout
            android:id="@+id/btnSubmitReset"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forgot_button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_green"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/reset_btn_submit"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/forgot_button_text_size"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>