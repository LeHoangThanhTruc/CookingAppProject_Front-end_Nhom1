<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_pill_white"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <!-- TẦNG 1: HEADER (Cố định chiều cao) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/bxs_user"
            app:shapeAppearanceOverlay="@style/CircularImageView" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/imgAvatar"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#193B1C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#718096"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/imgPrivacy"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/public_globe" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- TẦNG 2: CAPTION (Co giãn linh hoạt theo dữ liệu text) -->
    <TextView
        android:id="@+id/tvCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:paddingHorizontal="14dp"
        android:textColor="#2D3748"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnToggleCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="2dp"
        android:text="Xem thêm"
        android:textColor="@color/panda_green"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- TẦNG 3: KHUNG MEDIA CONTAINER (Bài Share & Grid ảnh nằm trọn ở đây) -->
    <FrameLayout
        android:id="@+id/containerMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <!-- A. KHUNG BÀI GỐC ĐƯỢC SHARE (Nằm gọn bên trong Khung Media) -->
        <LinearLayout
            android:id="@+id/layoutOriginalPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_figma_card"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgOrigAvatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bxs_user"
                    app:shapeAppearanceOverlay="@style/CircularImageView" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvOrigAuthorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvOrigTimeAgo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#718096"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/imgOrigPrivacy"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/public_globe" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvOrigCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#4A5568"
                android:textSize="13sp" />

            <!-- Media của bài gốc -->
            <ImageView
                android:id="@+id/imgOrigPostMedia"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </LinearLayout>

        <!-- B. GRID MEDIA ĐA DẠNG (1 ảnh full, 2-3 ảnh, 4+ ảnh với ô +N) -->
        <GridLayout
            android:id="@+id/gridMedia"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:columnCount="2"
            android:rowCount="2"
            android:visibility="gone">

            <!-- 4 View ảnh được định vị sẵn trong Grid -->
            <ImageView
                android:id="@+id/imgMedia1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imgMedia2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imgMedia3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop" />

            <RelativeLayout
                android:id="@+id/layoutMediaOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="1dp">

                <ImageView
                    android:id="@+id/imgMedia4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Lớp phủ mờ hiện chữ +N (VD: +4) -->
                <TextView
                    android:id="@+id/tvMoreMediaCount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#80000000"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </RelativeLayout>
        </GridLayout>
    </FrameLayout>

    <!-- TẦNG 4: BOTTOM ACTION BAR (Cố định chiều cao & khoảng cách) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:id="@+id/btnLike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imgLike"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/heart" />
            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#718096"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chat"
                app:tint="#718096" />
            <TextView
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#718096"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/share_icon" />
            <TextView
                android:id="@+id/tvShareCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#718096"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imgSave"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/save_icon" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>