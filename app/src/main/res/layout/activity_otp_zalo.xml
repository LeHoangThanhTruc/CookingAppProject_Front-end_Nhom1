<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <!-- Lớp ảnh nền dưới cùng -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/background2" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Nút Quay lại (Back Button) -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Quay lại"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/panda_green_dark" />

                <!-- Tiêu đề màn hình -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Nhập mã xác minh"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- OTP DESCRIPTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOtpDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Mã xác thực đã được gửi qua Zalo đến số điện thoại"
                    android:textColor="@color/panda_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivZaloIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Zalo"
                        android:src="@drawable/ic_zalo" />

                    <TextView
                        android:id="@+id/tvPhoneTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(+84) 983 114 724"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- OTP DIGIT UNDERLINES / SLOTS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Slot 1 -->
                <View
                    android:id="@+id/viewOtp1"
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/panda_green" />
                <!-- Slot 2 -->
                <View
                    android:id="@+id/viewOtp2"
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#CBD5E1" />
                <!-- Slot 3 -->
                <View
                    android:id="@+id/viewOtp3"
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#CBD5E1" />
                <!-- Slot 4 -->
                <View
                    android:id="@+id/viewOtp4"
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#CBD5E1" />
                <!-- Slot 5 -->
                <View
                    android:id="@+id/viewOtp5"
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#CBD5E1" />
                <!-- Slot 6 -->
                <View
                    android:id="@+id/viewOtp6"
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#CBD5E1" />
            </LinearLayout>

            <!-- NÚT TIẾP THEO -->
            <LinearLayout
                android:id="@+id/btnNextOtp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_green"
                android:clickable="true"
                android:elevation="1dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNextOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiếp theo"
                    android:textColor="@color/panda_card"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RESEND TIMER TEXT -->
            <TextView
                android:id="@+id/tvResendTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="36dp"
                android:text="Vui lòng chờ 50 giây để nhận lại mã xác thực"
                android:textColor="@color/panda_gray"
                android:textSize="13sp" />

            <!-- KHOẢNG TRỐNG ĐẨY NỘI DUNG LÊN TRÊN -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
