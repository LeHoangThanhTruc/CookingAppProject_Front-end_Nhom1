<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg">

    <View
        android:layout_width="126dp"
        android:layout_height="202dp"
        android:layout_marginStart="-36dp"
        android:layout_marginTop="-30dp"
        android:alpha="0.7"
        android:background="@drawable/bg_figma_deco" />

    <View
        android:layout_width="132dp"
        android:layout_height="214dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-42dp"
        android:layout_marginBottom="21dp"
        android:alpha="0.68"
        android:background="@drawable/bg_figma_deco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="17dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_white"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Trò chuyện"
                        android:textColor="@color/panda_green_light_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Huy Hoàng"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_figma_avatar"
                    android:gravity="center"
                    android:text="H"
                    android:textColor="@color/panda_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="691dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_figma_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cuộc trò chuyện"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="H"
                        android:textColor="@color/panda_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="248dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_figma_bubble_received"
                        android:padding="12dp"
                        android:text="Huy Hoàng&#10;Bạn đã thử công thức gà rán mật ong mới chưa?&#10;09:42"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="248dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_figma_bubble_sent"
                    android:padding="12dp"
                    android:text="Bạn&#10;Chưa, mình đang tìm công thức cho bữa tối. Bạn có thể chia sẻ lại không?&#10;• Đã xem"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="H"
                        android:textColor="@color/panda_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="248dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_figma_bubble_received"
                        android:padding="12dp"
                        android:text="Huy Hoàng&#10;Mình dùng 2 thìa mật ong, 1 thìa nước cốt chanh và 1 thìa dầu hào. Ướp khoảng 20 phút trước khi chiên.&#10;09:45"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="248dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_figma_bubble_sent"
                    android:padding="12dp"
                    android:text="Bạn&#10;Cảm ơn bạn! Mình sẽ thử ngay tối nay và cho bạn biết kết quả.&#10;• Đã xem"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="H"
                        android:textColor="@color/panda_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="248dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_figma_bubble_received"
                        android:padding="12dp"
                        android:text="Nhớ chiên lửa vừa nhé!&#10;09:46"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="248dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_figma_bubble_sent"
                    android:padding="12dp"
                    android:text="Ok, mình nhớ rồi! 😊&#10;• Đã xem"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="101dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_figma_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Soạn tin nhắn"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_figma_icon_circle"
                        android:gravity="center"
                        android:text="📎"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_figma_input"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Nhập tin nhắn…"
                        android:textColor="@color/panda_gray"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_figma_icon_circle"
                        android:gravity="center"
                        android:text="➤"
                        android:textColor="@color/panda_green"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
