<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg">

    <View
        android:layout_width="126dp"
        android:layout_height="202dp"
        android:layout_marginStart="-36dp"
        android:layout_marginTop="-30dp"
        android:alpha="0.7"
        android:background="@drawable/bg_figma_deco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="138dp"
        android:alpha="0.16"
        android:text="🍜"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="322dp"
        android:layout_marginTop="92dp"
        android:alpha="0.16"
        android:text="🥗"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="292dp"
        android:layout_marginTop="246dp"
        android:alpha="0.16"
        android:text="⭐"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="338dp"
        android:layout_marginTop="540dp"
        android:alpha="0.16"
        android:text="🍳"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="564dp"
        android:alpha="0.16"
        android:text="🥢"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <View
        android:layout_width="132dp"
        android:layout_height="214dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-42dp"
        android:layout_marginBottom="21dp"
        android:alpha="0.68"
        android:background="@drawable/bg_figma_deco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="86dp"
        android:layout_marginBottom="135dp"
        android:alpha="0.16"
        android:text="♡"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="46dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_white"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Thông Báo"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="795dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_figma_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Danh sách thông báo"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 thông báo"
                        android:textColor="@color/panda_green_mid"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Chưa đọc"
                    android:textColor="@color/panda_green_light_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="H"
                        android:textColor="@color/panda_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Huy Hoàng"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Đã gửi cho bạn lời mời kết bạn"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="10:18"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="🗑"
                        android:textColor="@color/panda_red"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@color/panda_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Anh An"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Đã gửi cho bạn lời mời kết bạn"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="09:42"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="🗑"
                        android:textColor="@color/panda_red"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Đã đọc"
                    android:textColor="@color/panda_green_light_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="L"
                        android:textColor="@color/panda_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Linh Linh"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Đã chia sẽ bài viết của bạn"
                            android:textColor="@color/panda_gray"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="13:05"
                        android:textColor="@color/panda_gray"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="🗑"
                        android:textColor="@color/panda_red"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_figma_avatar"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="@color/panda_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Minh Minh"
                            android:textColor="@color/panda_green_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Đã thích công thức của bạn"
                            android:textColor="@color/panda_gray"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Hôm qua"
                        android:textColor="@color/panda_gray"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="🗑"
                        android:textColor="@color/panda_red"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
