<?xml version="1.0" encoding="utf-8"?>
<!-- Root Container: LinearLayout tràn background1.png -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background1"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <!-- 1. TỔNG THỂ SCROLLVIEW (Cuộn toàn bộ trang) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/main_screen_padding_horizontal"
            android:paddingEnd="@dimen/main_screen_padding_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ================= TOP HEADER (TIÊU ĐỀ + NÚT HOME) ================= -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSearchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/search_title"
                    android:textColor="#193B1C"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnHome"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/home_in_circle" />
            </RelativeLayout>


            <!-- ================= Ô NHẬP TÌM KIẾM (CÓ TÍNH NĂNG SCROLL CHỮ LÊN XUỐNG) ================= -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_white"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/iconSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_kinhlup_mini" />

                <ImageView
                    android:id="@+id/btnToggleFilter"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/sliders" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/btnToggleFilter"
                    android:layout_toEndOf="@id/iconSearch"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <EditText
                        android:id="@+id/edtSearchQuery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:autofillHints="name"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:paddingHorizontal="10dp"
                        android:textColor="#193B1C"
                        android:textColorHint="#9EAFA0"
                        android:textSize="14sp" />
                </ScrollView>
            </RelativeLayout>


            <!-- ================= THANH LỌC LOẠI ĐỐI TƯỢNG (HORIZONTAL SCROLL) ================= -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTypeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_green"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/search_type_all"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTypeDishes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/search_type_dishes"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTypeUsers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/search_type_users"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/search_cat_savory"
                        android:textColor="#193B1C"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/search_cat_vegetarian"
                        android:textColor="#193B1C"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>


            <!-- ================= KHU VỰC BỘ LỌC NÂNG CAO ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Header Bộ lọc nâng cao + Chevron -->
                <LinearLayout
                    android:id="@+id/layoutAdvancedHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_filter_advanced"
                        android:textColor="#193B1C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgChevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/chevron_down" />
                </LinearLayout>

                <!-- CARD BỘ LỌC NÂNG CAO -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/cardAdvancedFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_white"
                    android:maxHeight="260dp"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 1. Nguyên liệu loại trừ -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/search_filter_exclude"
                                android:textColor="#193B1C"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="#F0F7F0"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/search_filter_seafood"
                                    android:textColor="#2D7A32"
                                    android:textSize="12sp"
                                    app:drawableEndCompat="@drawable/x" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="#F0F7F0"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/search_filter_water_spinach"
                                    android:textColor="#2D7A32"
                                    android:textSize="12sp"
                                    app:drawableEndCompat="@drawable/x" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- 2. Mức sao đánh giá -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/search_filter_rating"
                                android:textColor="#193B1C"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="#F0F7F0"
                                android:drawablePadding="4dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="@string/search_filter_rating_val"
                                android:textColor="#2D7A32"
                                android:textSize="12sp"
                                app:drawableEndCompat="@drawable/x"
                                app:drawableStartCompat="@drawable/star" />
                        </RelativeLayout>

                        <!-- 3. Độ phức tạp -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/search_filter_difficulty"
                                android:textColor="#193B1C"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="#F0F7F0"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/search_filter_easy"
                                    android:textColor="#2D7A32"
                                    android:textSize="12sp"
                                    app:drawableEndCompat="@drawable/x"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="#F0F7F0"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/search_filter_medium"
                                    android:textColor="#2D7A32"
                                    android:textSize="12sp"
                                    app:drawableEndCompat="@drawable/x" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- 4. Thời gian nấu -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/search_filter_time"
                                android:textColor="#193B1C"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="#F0F7F0"
                                android:drawablePadding="4dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="@string/search_filter_under_30m"
                                android:textColor="#2D7A32"
                                android:textSize="12sp"
                                app:drawableEndCompat="@drawable/x"
                                app:drawableStartCompat="@drawable/clock" />
                        </RelativeLayout>

                        <!-- NÚT ĐẶT LẠI & ÁP DỤNG-->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnResetFilter"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_pill_white"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/search_filter_reset"
                                android:textColor="#2D7A32"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <!-- Nút Áp dụng chèn icon_mini_bamboo bên trái -->
                            <TextView
                                android:id="@+id/btnApplyFilter"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button_green"
                                android:clickable="true"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/search_filter_apply"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>


            <!-- ================= CHỦ ĐỀ GỢI Ý ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/search_section_suggested"
                android:textColor="#193B1C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/disk_phobo2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/search_dish_phobo"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/disk_banhmi" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/search_dish_banhmi"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/disk_goicuon_vuong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/search_dish_goicuon"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>


            <!-- ================= CÔNG THỨC PHỔ BIẾN ================= -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/search_section_popular"
                    android:textColor="#193B1C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/main_action_see_all"
                    android:textColor="#2D7A32"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Card Món ăn nổi bật -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_white"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/disk_goicuon_chunhat" />

                    <!-- Nút Lưu-->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/save_icon" />
                </RelativeLayout>

                <!-- Tên món & Điểm sao -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/search_dish_goicuon_full"
                        android:textColor="#193B1C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:drawablePadding="4dp"
                        android:text="@string/search_dish_rating_val"
                        android:textColor="#193B1C"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/star" />
                </RelativeLayout>

                <!-- Thông tin thêm: Thời gian + Độ khó -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:text="@string/search_dish_time_val"
                        android:textColor="#718096"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/clock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:drawablePadding="4dp"
                        android:text="@string/search_filter_easy"
                        android:textColor="#718096"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/flame" />
                </LinearLayout>

                <!-- Nút Xem công thức-->
                <TextView
                    android:id="@+id/btnViewRecipe"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_green"
                    android:clickable="true"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/search_action_view_recipe"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />


            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>