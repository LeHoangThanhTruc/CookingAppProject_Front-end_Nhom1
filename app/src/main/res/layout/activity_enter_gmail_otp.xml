<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="30dp">

            <!-- Nút Quay lại (Back Button) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                android:tint="@color/panda_green_dark" />

            <!-- Tiêu đề màn hình -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nhập mã xác minh"
                android:textColor="@color/panda_green_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- OTP DESCRIPTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="30dp">

            <TextView
                android:id="@+id/tvOtpDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã xác thực đã được gửi đến số Email"
                android:textColor="@color/panda_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEmailTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24521868@gm.uit.edu.vn"
                android:textColor="@color/panda_green_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- OTP DIGIT UNDERLINES / SLOTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Slot 1 -->
            <View android:id="@+id/viewOtp1" android:layout_width="36dp" android:layout_height="2dp" android:background="@color/panda_green" android:layout_marginHorizontal="6dp" />
            <!-- Slot 2 -->
            <View android:id="@+id/viewOtp2" android:layout_width="36dp" android:layout_height="2dp" android:background="#CBD5E1" android:layout_marginHorizontal="6dp" />
            <!-- Slot 3 -->
            <View android:id="@+id/viewOtp3" android:layout_width="36dp" android:layout_height="2dp" android:background="#CBD5E1" android:layout_marginHorizontal="6dp" />
            <!-- Slot 4 -->
            <View android:id="@+id/viewOtp4" android:layout_width="36dp" android:layout_height="2dp" android:background="#CBD5E1" android:layout_marginHorizontal="6dp" />
            <!-- Slot 5 -->
            <View android:id="@+id/viewOtp5" android:layout_width="36dp" android:layout_height="2dp" android:background="#CBD5E1" android:layout_marginHorizontal="6dp" />
            <!-- Slot 6 -->
            <View android:id="@+id/viewOtp6" android:layout_width="36dp" android:layout_height="2dp" android:background="#CBD5E1" android:layout_marginHorizontal="6dp" />
        </LinearLayout>

        <!-- NÚT TIẾP THEO -->
        <LinearLayout
            android:id="@+id/btnNextOtp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_badge_published"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="1dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvNextOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiếp theo"
                android:textColor="@color/panda_green"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RESEND TIMER TEXT -->
        <TextView
            android:id="@+id/tvResendTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vui lòng chờ 55 giây để nhận lại mã xác thực"
            android:textColor="@color/panda_gray"
            android:textSize="13sp"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- KHOẢNG TRỐNG ĐẨY BÀN PHÍM SỐ XUỐNG DƯỚI -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- NUMERIC KEYPAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FAFAFA">

            <!-- Row 1: 1, 2, 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/key1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textColor="@color/panda_green_dark" android:textSize="22sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/key2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2\nABC" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/key3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3\nDEF" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <!-- Row 2: 4, 5, 6 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/key4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4\nGHI" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/key5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5\nJKL" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/key6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6\nMNO" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <!-- Row 3: 7, 8, 9 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/key7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7\nPQRS" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/key8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8\nTUV" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/key9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9\nWXYZ" android:textColor="@color/panda_green_dark" android:textSize="18sp" android:gravity="center" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <!-- Row 4: empty, 0, backspace -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/key0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" android:textColor="@color/panda_green_dark" android:textSize="22sp" android:gravity="center" android:clickable="true" android:focusable="true" />
                <LinearLayout
                    android:id="@+id/keyBackspace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_backspace"
                        android:contentDescription="Xóa"
                        android:tint="@color/panda_green" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>