<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background1"
    android:orientation="vertical"
    android:paddingStart="@dimen/forgot_screen_padding_horizontal"
    android:paddingEnd="@dimen/forgot_screen_padding_horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    tools:ignore="UnusedResources">

    <!-- ================= 1. TOP HEADER BAR ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nút Quay về -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_white"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/vector_back" />

        <!-- Tiêu đề Quên mật khẩu nằm chính giữa Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/forgot_password_title"
            android:textColor="#1B4D2E"
            android:textSize="@dimen/forgot_title_size"
            android:textStyle="bold" />
    </RelativeLayout>


    <!-- ================= 2. CARD HƯỚNG DẪN (BANNER TRẮNG) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cụm Icon Gmail + "or" + Phone -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Icon Gmail lồng trong deco_circle_ -->
            <RelativeLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/deco_circle_" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null"
                    android:src="@drawable/selfhst_gmail" />
            </RelativeLayout>

            <!-- Chữ 'or' ở giữa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/forgot_password_or"
                android:textColor="#718096"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 2. Icon Phone lồng trong deco_circle_ -->
            <RelativeLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/deco_circle_" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null"
                    android:src="@drawable/phone" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Tiêu đề Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/forgot_password_banner_title"
            android:textColor="#1B4D2E"
            android:textSize="@dimen/forgot_banner_title_size"
            android:textStyle="bold" />

        <!-- Mô tả Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/forgot_password_banner_desc"
            android:textColor="#718096"
            android:textSize="@dimen/forgot_banner_desc_size" />
    </LinearLayout>


    <!-- ================= 3. CARD KHUNG NHẬP LIỆU & NÚT TIẾP TỤC ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_white"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Label nhập Email hoặc SĐT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password_label_input"
            android:textColor="#1B4D2E"
            android:textSize="@dimen/forgot_label_size"
            android:textStyle="bold" />

        <!-- Ô Nhập liệu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/forgot_input_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/edtEmailOrPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="emailAddress,phoneNumber"
                android:background="@null"
                android:hint="@string/forgot_password_hint_input"
                android:inputType="textEmailAddress|phone"
                android:textColor="#2D3748"
                android:textColorHint="#A0AEC0"
                android:textSize="@dimen/forgot_input_text_size" />
        </RelativeLayout>

        <!-- Nút Tiếp tục -->
        <RelativeLayout
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forgot_button_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_green"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/forgot_password_btn_submit"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/forgot_button_text_size"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>