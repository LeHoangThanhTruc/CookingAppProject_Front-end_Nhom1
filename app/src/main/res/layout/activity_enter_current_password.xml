<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg"
    android:fillViewport="true"
    tools:ignore="HardcodedText,Autofill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Nút Quay lại (Back Button) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                android:elevation="2dp"
                android:tint="@color/panda_green_dark" />

            <!-- Khối Tiêu đề màn hình -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvHeaderCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bảo mật"
                    android:textColor="#8AA68A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập mật khẩu"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xác nhận mật khẩu hiện tại để tiếp tục"
                    android:textColor="@color/panda_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nút Cài đặt / Gear Icon -->
            <ImageButton
                android:id="@+id/btnGearHeader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:src="@drawable/ic_gear"
                android:contentDescription="Cài đặt"
                android:elevation="2dp"
                android:tint="@color/panda_green_dark" />

        </LinearLayout>

        <!-- CARD CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu hiện tại"
                android:textColor="@color/panda_green_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <!-- PASSWORD INPUT FIELD -->
            <LinearLayout
                android:id="@+id/layoutCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivLockIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Mật khẩu"
                    android:tint="@color/panda_green" />

                <EditText
                    android:id="@+id/etCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Nhập mật khẩu hiện tại"
                    android:textColor="@color/panda_green_dark"
                    android:textColorHint="@color/panda_gray"
                    android:textSize="14sp"
                    android:layout_marginStart="10dp"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- LINK QUÊN MẬT KHẨU -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu"
                android:textColor="@color/panda_green_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- NÚT TIẾP THEO -->
            <LinearLayout
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_primary"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:elevation="1dp">

                <TextView
                    android:id="@+id/tvNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiếp theo"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- KHOẢNG TRỐNG ĐẨY NỘI DUNG LÊN TRÊN -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</ScrollView>