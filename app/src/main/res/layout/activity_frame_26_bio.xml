<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panda_bg">

    <View
        android:layout_width="126dp"
        android:layout_height="202dp"
        android:layout_marginStart="-36dp"
        android:layout_marginTop="-30dp"
        android:alpha="0.7"
        android:background="@drawable/bg_figma_deco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="138dp"
        android:alpha="0.16"
        android:text="🍜"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="322dp"
        android:layout_marginTop="92dp"
        android:alpha="0.16"
        android:text="🥗"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="292dp"
        android:layout_marginTop="246dp"
        android:alpha="0.16"
        android:text="⭐"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="338dp"
        android:layout_marginTop="540dp"
        android:alpha="0.16"
        android:text="🍳"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="564dp"
        android:alpha="0.16"
        android:text="🥢"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <View
        android:layout_width="132dp"
        android:layout_height="214dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-42dp"
        android:layout_marginBottom="21dp"
        android:alpha="0.68"
        android:background="@drawable/bg_figma_deco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="86dp"
        android:layout_marginBottom="135dp"
        android:alpha="0.16"
        android:text="♡"
        android:textColor="@color/panda_green_light_text"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_white"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hồ sơ"
                        android:textColor="@color/panda_green_light_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giới thiệu bản thân"
                        android:textColor="@color/panda_green_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cập nhật thông tin cá nhân để mọi người hiểu rõ hơn về bạn"
                        android:textColor="@color/panda_green_mid"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_white"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="@color/panda_green"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="780dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_figma_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thông tin giới thiệu"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Họ Và Tên"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_figma_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Nhập họ và tên"
                    android:textColor="@color/panda_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="SĐT"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_figma_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Nhập số điện thoại"
                    android:textColor="@color/panda_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Gmail"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_figma_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Nhập địa chỉ email"
                    android:textColor="@color/panda_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Giới thiệu chung"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="333dp"
                    android:background="@drawable/bg_figma_input"
                    android:gravity="top"
                    android:padding="16dp"
                    android:text="Viết một vài dòng giới thiệu về bản thân, sở thích hoặc phong cách nấu ăn của bạn"
                    android:textColor="@color/panda_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_figma_green_button"
                    android:gravity="center"
                    android:text="Cập nhật"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
