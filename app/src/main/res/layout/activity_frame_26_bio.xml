<?xml version="1.0" encoding="utf-8"?>
<!-- 1. LinearLayout ngoài cùng bao bọc toàn bộ giao diện, dùng background1 tràn màn hình -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background1"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:weightSum="1.0">

    <!-- ================= PHẦN 1: HEADER (TỶ LỆ 15% - weight = 0.15) ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.15">

        <!-- Nút Back ở góc trên bên trái -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/deco_circle_"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:src="@drawable/vector_back" />

        <!-- Cụm Tiêu đề nằm kế bên Nút Back -->
        <LinearLayout
            android:id="@+id/layoutHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBack"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hồ sơ"
                android:textColor="#2D6A32"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giới thiệu bản thân"
                android:textColor="#1A202C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cập nhật thông tin cá nhân để mọi người hiểu rõ hơn về bạn"
                android:textColor="#718096"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Nút Cài đặt / Gear bên góc phải -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnGear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/deco_circle_"
            android:contentDescription="Cài đặt"
            android:padding="10dp"
            android:src="@drawable/ic_gear"
            app:tint="@color/panda_gray" />

    </RelativeLayout>


    <!-- ================= PHẦN 2: THÔNG TIN GIỚI THIỆU (TỶ LỆ 75% - weight = 0.75) ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="0.75"
        android:background="@drawable/bg_pill_white"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Tiêu đề nhóm thông tin -->
                <TextView
                    android:id="@+id/tvTitleSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin giới thiệu"
                    android:textColor="#1A202C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 1. Họ Và Tên -->
                <TextView
                    android:id="@+id/tvLabelFullname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTitleSection"
                    android:layout_marginTop="12dp"
                    android:text="Họ Và Tên"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/layoutInputFullname"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/tvLabelFullname"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/edtFullname"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Nhập họ và tên"
                        android:inputType="textPersonName"
                        android:textColor="#1A202C"
                        android:textColorHint="#A0AEC0"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- 2. SĐT -->
                <TextView
                    android:id="@+id/tvLabelPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layoutInputFullname"
                    android:layout_marginTop="12dp"
                    android:text="SĐT"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/layoutInputPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/tvLabelPhone"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/edtPhone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Nhập số điện thoại"
                        android:inputType="phone"
                        android:textColor="#1A202C"
                        android:textColorHint="#A0AEC0"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- 3. Gmail -->
                <TextView
                    android:id="@+id/tvLabelEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layoutInputPhone"
                    android:layout_marginTop="12dp"
                    android:text="Gmail"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/layoutInputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/tvLabelEmail"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Nhập địa chỉ email"
                        android:inputType="textEmailAddress"
                        android:textColor="#1A202C"
                        android:textColorHint="#A0AEC0"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- 4. Giới thiệu chung (Nhiều dòng) -->
                <TextView
                    android:id="@+id/tvLabelBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layoutInputEmail"
                    android:layout_marginTop="12dp"
                    android:text="Giới thiệu chung"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/layoutInputBio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/tvLabelBio"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pill_white"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/edtBio"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="Viết một vài dòng giới thiệu về bản thân, sở thích hoặc phong cách nấu ăn của bạn"
                        android:inputType="textMultiLine"
                        android:textColor="#1A202C"
                        android:textColorHint="#A0AEC0"
                        android:textSize="14sp" />
                </RelativeLayout>

            </RelativeLayout>
        </ScrollView>
    </RelativeLayout>


    <!-- ================= PHẦN 3: NÚT CẬP NHẬT (TỶ LỆ 10% - weight = 0.10) ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.10">

        <!-- Nút Cập nhật căn giữa phần 3 -->
        <RelativeLayout
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_button_green"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Cập nhật"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>