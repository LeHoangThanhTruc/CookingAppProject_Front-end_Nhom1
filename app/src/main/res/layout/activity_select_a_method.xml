<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <!-- Lớp ảnh nền dưới cùng -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/background2" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Nút Quay lại (Back Button) -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Quay lại"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/panda_green_dark" />

                <!-- Tiêu đề màn hình -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Vui lòng chọn:"
                    android:textColor="@color/panda_green_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- DESCRIPTION TEXT -->
            <TextView
                android:id="@+id/tvMethodDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Chọn 1 trong những phương thức bên dưới để nhận mã xác nhận đến số (+84) 983 114 724"
                android:textColor="@color/panda_green_dark"
                android:textSize="14sp" />

            <!-- OPTION 1: ZALO -->
            <LinearLayout
                android:id="@+id/btnZaloOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <ImageView
                    android:id="@+id/ivZaloIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_green"
                    android:contentDescription="Zalo"
                    android:padding="8dp"
                    android:src="@drawable/ic_zalo"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvZaloTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Zalo"
                    android:textColor="@color/panda_gray"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivZaloChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Mở rộng"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/panda_gray" />
            </LinearLayout>

            <!-- OPTION 2: TIN NHẮN (SMS) -->
            <LinearLayout
                android:id="@+id/btnSmsOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <ImageView
                    android:id="@+id/ivSmsIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_green"
                    android:contentDescription="Tin nhắn"
                    android:padding="8dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvSmsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Tin nhắn"
                    android:textColor="@color/panda_gray"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivSmsChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Mở rộng"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/panda_gray" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
