<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Avatar Bạn bè -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFriendAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bxs_user"
            app:shapeAppearanceOverlay="@style/CircularImageView" />

        <!-- Dấu tích xanh khi được chọn (Mặc định ẩn) -->
        <ImageView
            android:id="@+id/imgSelectedCheck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignEnd="@id/imgFriendAvatar"
            android:layout_alignBottom="@id/imgFriendAvatar"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvFriendName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#2D3748"
        android:textSize="11sp" />
</LinearLayout>